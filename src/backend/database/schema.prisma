// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
  // CommonJS so Jest (ts-jest) can load the client in tests; Next.js works with either format
  moduleFormat = "cjs"
}

// The connection URL lives in prisma.config.ts (CLI/migrations) and database.ts (app runtime).
// For poolers (Supabase/Neon on serverless): give the app the pooled URL and the CLI the direct URL.
datasource db {
  provider = "postgresql"
}

model User {
  id          String    @id @default(uuid()) @map("id")
  name        String?   @map("name")
  email       String    @unique @map("email")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  lastLoginAt DateTime? @map("last_login_at")

  @@map("users") // table name
}
